# URL base da API do backend.
# Para testar pelo celular (mesma rede Wi-Fi), troque localhost pelo IP da
# máquina (ipconfig -> IPv4 do Wi-Fi), ex.: http://192.168.0.10:3001/api
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# OAuth Client ID do Google (Google Cloud Console -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
